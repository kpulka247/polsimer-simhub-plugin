          "ContentFormula": {
            "JSExt": 0,
            "Interpreter": 1,
            "Expression": "if ($prop('DataCorePlugin.GameRunning') == 0) return new Array(12).fill('#ff000000');\r\nvar rpm = $prop('Rpms') || 0;\r\nvar ignition = $prop('EngineIgnitionOn') == 1;\r\nif (rpm < 350 && !ignition) return new Array(12).fill('#ff000000');\r\nvar maxRpm = $prop('CarSettings.MaxRpm') || $prop('MaxRpm') || 8000;\r\nif (maxRpm <= 1000) maxRpm = 8000;\r\nvar startRatio = 0.80;\r\nvar endRatio = 0.95;\r\nvar ratio = rpm / maxRpm;\r\nvar out = new Array(12).fill('#ff000000');\r\nif (ratio < startRatio) return out;\r\nvar progress = Math.min(1.0, Math.max(0.0, (ratio - startRatio) / (endRatio - startRatio)));\r\nvar carClass = ($prop('CarClass') || '').toUpperCase();\r\nvar carModel = ($prop('CarModel') || '').toUpperCase();\r\nvar isGT3 = carClass.includes('GT3') || carClass.includes('GTE') || carClass.includes('GT4') || carClass.includes('CUP') || carModel.includes('GT3') || carModel.includes('CUP') || carModel.includes('PORSCHE') || carModel.includes('296');\r\nif (isGT3) {\r\n    var pairs = Math.min(6, Math.round(progress * 6));\r\n    for (var p = 0; p < pairs; p++) {\r\n        var col = '#ff00ff00';\r\n        if (p >= 2 && p < 4) col = '#ffffff00';\r\n        else if (p >= 4) col = '#ffff0000';\r\n        out[p] = col;\r\n        out[11 - p] = col;\r\n    }\r\n} else {\r\n    var ledsOn = Math.min(12, Math.round(progress * 12));\r\n    for (var i = 0; i < ledsOn; i++) {\r\n        var col = '#ff00ff00';\r\n        if (i >= 4 && i < 8) col = '#ffffff00';\r\n        else if (i >= 8) col = '#ffff0000';\r\n        out[i] = col;\r\n    }\r\n}\r\nreturn out;"
