            "Interpreter": 1,
            "Expression": "if ($prop('DataCorePlugin.GameRunning') != 0) {\r\n    root.polsimer_idleStart = 0;\r\n    return new Array(12).fill('#00000000');\r\n}\r\n\r\nvar conn = $prop('Polsimer F74LED.Connected');\r\nif (conn === null || typeof conn === 'undefined') {\r\n    conn = $prop('PolsimerF74LedPlugin.Connected');\r\n}\r\nvar isConnected = (conn === true || conn == 1);\r\n\r\nif (!isConnected) {\r\n    root.polsimer_idleStart = 0;\r\n    root.polsimer_lastConnId = -1;\r\n    return new Array(12).fill('#ff000000');\r\n}\r\n\r\nvar now = Date.now();\r\nvar connId = $prop('PolsimerF74LedPlugin.ConnectionId') || $prop('Polsimer F74LED.ConnectionId') || 0;\r\n\r\nif (typeof root.polsimer_lastConnId === 'undefined') root.polsimer_lastConnId = -1;\r\nif (typeof root.polsimer_idleStart === 'undefined') root.polsimer_idleStart = 0;\r\n\r\nif (connId !== root.polsimer_lastConnId || root.polsimer_idleStart === 0) {\r\n    root.polsimer_lastConnId = connId;\r\n    root.polsimer_idleStart = now;\r\n}\r\n\r\nvar totalTime = 5000;\r\nvar elapsed = now - root.polsimer_idleStart;\r\nvar cycle = elapsed % totalTime;\r\nif ((cycle >= 1500 && cycle < 2500) || cycle >= 4000) {\r\n    return new Array(12).fill('#ff000000');\r\n}\r\nvar D;\r\nif (cycle < 1500) {\r\n    var s = cycle / 1500;\r\n    D = -0.7 + 7.4 * (1 - Math.sin(s * Math.PI / 2));\r\n} else {\r\n    var s = (cycle - 2500) / 1500;\r\n    D = -0.7 + 7.4 * Math.sin(s * Math.PI / 2);\r\n}\r\nvar W = 2.15;\r\nvar out = [];\r\nfor (var i = 0; i < 12; i++) {\r\n    var d = Math.abs(i - 5.5);\r\n    var u = Math.abs(d - D);\r\n    if (u <= W) {\r\n        var fade = Math.cos((u / W) * Math.PI / 2);\r\n        var hue = ((d / 5.5) * 0.75 + (elapsed % 3500) / 3500) % 1.0;\r\n        var h6 = hue * 6;\r\n        var f_r = Math.max(0, Math.min(1, Math.abs(h6 - 3) - 1));\r\n        var f_g = Math.max(0, Math.min(1, 2 - Math.abs(h6 - 2)));\r\n        var f_b = Math.max(0, Math.min(1, 2 - Math.abs(h6 - 4)));\r\n        var r = Math.floor(f_r * 180 * fade);\r\n        var g = Math.floor(f_g * 180 * fade);\r\n        var b = Math.floor(f_b * 180 * fade);\r\n        if (u <= 0.4) {\r\n            var core = (1 - u / 0.4) * 55;\r\n            r = Math.min(255, r + Math.floor(core));\r\n            g = Math.min(255, g + Math.floor(core));\r\n            b = Math.min(255, b + Math.floor(core));\r\n        }\r\n        var rh = (r < 16 ? '0' : '') + r.toString(16);\r\n        var gh = (g < 16 ? '0' : '') + g.toString(16);\r\n        var bh = (b < 16 ? '0' : '') + b.toString(16);\r\n        out.push('#ff' + rh + gh + bh);\r\n    } else {\r\n        out.push('#ff000000');\r\n    }\r\n}\r\nreturn out;"
