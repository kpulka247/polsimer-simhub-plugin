        {
          "ContentFormula": {
            "JSExt": 0,
            "Interpreter": 1,
            "Expression": "if ($prop('DataCorePlugin.GameRunning') == 0) return new Array(12).fill('#00000000');\r\nvar rpm = $prop('Rpms') || 0;\r\nvar ignition = $prop('EngineIgnitionOn') == 1;\r\nif (rpm < 350 && !ignition) return new Array(12).fill('#00000000');\r\nvar maxRpm = $prop('CarSettings.MaxRpm') || $prop('MaxRpm') || 8000;\r\nif (maxRpm <= 1000) maxRpm = 8000;\r\nvar ratio = rpm / maxRpm;\r\nvar redline = (ratio >= 0.965) || ($prop('RPMRedlineReached') && ratio >= 0.945);\r\nif (typeof root.polsimer_shiftHold === 'undefined') root.polsimer_shiftHold = 0;\r\nvar now = Date.now();\r\nif (redline) {\r\n    root.polsimer_shiftHold = now + 280;\r\n}\r\nif (now < root.polsimer_shiftHold) {\r\n    var fastBlink = (Math.floor(now / 65) % 2) === 0;\r\n    return new Array(12).fill(fastBlink ? '#ff00e5ff' : '#ff000000');\r\n}\r\nreturn new Array(12).fill('#00000000');"
          },
          "LedCount": 12,
