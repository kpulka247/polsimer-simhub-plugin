            "Expression": "if ($prop('DataCorePlugin.GameRunning') == 0) return new Array(12).fill('#00000000');\r\nvar rpm = $prop('Rpms') || 0;\r\nvar ignition = $prop('EngineIgnitionOn') == 1;\r\nif (rpm < 350 && !ignition) return new Array(12).fill('#00000000');\r\nvar tc = $prop('TCActive') > 0 || $prop('TcActive') > 0;\r\nif (!tc) return new Array(12).fill('#00000000');\r\nvar out = [];\r\nfor (var i = 0; i < 12; i++) {\r\n    if (i >= 6) {\r\n        out.push('#ff0022cc');\r\n    } else {\r\n        out.push('#00000000');\r\n    }\r\n}\r\nreturn out;"
