        {
          "ContentFormula": {
            "JSExt": 0,
            "Interpreter": 1,
            "Expression": "if ($prop('DataCorePlugin.GameRunning') == 0) return new Array(12).fill('#00000000');\r\nvar rpm = $prop('Rpms') || 0;\r\nvar ignition = $prop('EngineIgnitionOn') == 1;\r\nvar isRunning = (rpm > 350) || ignition;\r\nif (!isRunning) return new Array(12).fill('#00000000');\r\nvar inPit = $prop('PitLimiterOn') > 0 || $prop('IsInPitLane') > 0;\r\nif (!inPit) return new Array(12).fill('#00000000');\r\nvar speed = $prop('SpeedKmh') || 0;\r\nvar now = Date.now();\r\nvar out = new Array(12).fill('#ff000000');\r\nvar stepSlow = Math.floor(now / 360) % 2;\r\nvar stepFast3x = Math.floor(now / 120) % 2;\r\nif (speed <= 1.5) {\r\n    if (stepSlow === 0) {\r\n        out[0] = '#ffffff00'; out[11] = '#ffffff00';\r\n    } else {\r\n        out[1] = '#ffffff00'; out[10] = '#ffffff00';\r\n    }\r\n    return out;\r\n} else if (speed < 40) {\r\n    if (stepFast3x === 0) {\r\n        out[0] = '#ffff0000'; out[11] = '#ffff0000';\r\n    } else {\r\n        out[1] = '#ffff0000'; out[10] = '#ffff0000';\r\n    }\r\n    return out;\r\n} else {\r\n    if (stepSlow === 0) {\r\n        out[0] = '#ffffff00'; out[11] = '#ffffff00';\r\n    } else {\r\n        out[1] = '#ffffff00'; out[10] = '#ffffff00';\r\n    }\r\n    for (var i = 2; i <= 9; i++) {\r\n        var isBlue = (i % 2 === 0) ? (stepSlow === 0) : (stepSlow === 1);\r\n        out[i] = isBlue ? '#ff0022cc' : '#ffffffff';\r\n    }\r\n    return out;\r\n}"
          },
          "LedCount": 12,
          "ContainerType": "ScriptedContent",
          "Description": "Pit Limiter"
        },
        {
          "ContentFormula": {
            "JSExt": 0,
            "Interpreter": 1,
            "Expression": "if ($prop('DataCorePlugin.GameRunning') == 0) {\r\n    root.polsimer_engineRunning = false;\r\n    root.polsimer_animStart = 0;\r\n    return new Array(12).fill('#00000000');\r\n}\r\nif (typeof root.polsimer_engineRunning === 'undefined') {\r\n    root.polsimer_engineRunning = false;\r\n    root.polsimer_animStart = 0;\r\n}\r\nvar rpm = $prop('Rpms') || 0;\r\nvar ignition = $prop('EngineIgnitionOn') == 1;\r\nvar isRunning = (rpm > 350) || ignition;\r\nvar now = Date.now();\r\nif (isRunning && !root.polsimer_engineRunning) {\r\n    root.polsimer_animStart = now;\r\n}\r\nroot.polsimer_engineRunning = isRunning;\r\nvar elapsed = now - root.polsimer_animStart;\r\nif (root.polsimer_animStart === 0 || elapsed < 0 || elapsed > 2000) {\r\n    return new Array(12).fill('#00000000');\r\n}\r\nvar out = new Array(12).fill('#ff000000');\r\nif (elapsed < 1350) {\r\n    var progress = elapsed / 1350;\r\n    var maxLed = Math.floor(progress * 13);\r\n    var tick = Math.floor(now / 55);\r\n    var curG = Math.floor(255 - progress * 186);\r\n    var curB = Math.floor(255 * (1 - progress));\r\n    var gh = (curG < 16 ? '0' : '') + curG.toString(16);\r\n    var bh = (curB < 16 ? '0' : '') + curB.toString(16);\r\n    var dynColor = '#ffff' + gh + bh;\r\n    for (var i = 0; i < 12; i++) {\r\n        if ((11 - i) < maxLed) {\r\n            var rand = Math.sin(i * 99 + tick * 43);\r\n            if (rand > 0.15 || progress > 0.85) {\r\n                out[i] = dynColor;\r\n            } else {\r\n                out[i] = '#ff000000';\r\n            }\r\n        } else {\r\n            out[i] = '#ff000000';\r\n        }\r\n    }\r\n    return out;\r\n} else if (elapsed < 1650) {\r\n    return new Array(12).fill('#ffff4500');\r\n} else {\r\n    var wipeProg = (elapsed - 1650) / 350;\r\n    var wipeLed = Math.floor(wipeProg * 12);\r\n    for (var i = 0; i < 12; i++) {\r\n        out[i] = (i >= wipeLed) ? '#ffff4500' : '#ff000000';\r\n    }\r\n    return out;\r\n}"
          },
          "LedCount": 12,
          "ContainerType": "ScriptedContent",
          "Description": "Engine Startup"
        },
        {
          "ContentFormula": {
            "JSExt": 0,
            "Interpreter": 1,
            "Expression": "if ($prop('DataCorePlugin.GameRunning') == 0) {\r\n    root.polsimer_checkeredStart = 0;\r\n    root.polsimer_checkeredDone = false;\r\n    root.polsimer_greenStart = 0;\r\n    root.polsimer_wasGreen = false;\r\n    root.polsimer_lastFlagType = '';\r\n    root.polsimer_flagStart = 0;\r\n    return new Array(12).fill('#00000000');\r\n}\r\n\r\nvar rpm = $prop('Rpms') || 0;\r\nvar ignition = $prop('EngineIgnitionOn') == 1;\r\nif (rpm < 350 && !ignition) return new Array(12).fill('#00000000');\r\n\r\nvar now = Date.now();\r\n\r\nvar lap = $prop('CurrentLap') || $prop('Lap') || 0;\r\nvar inPit = $prop('PitLimiterOn') > 0 || $prop('IsInPitLane') > 0;\r\nif (inPit && lap <= 1) {\r\n    root.polsimer_checkeredStart = 0;\r\n    root.polsimer_checkeredDone = false;\r\n}\r\n\r\nif (typeof root.polsimer_checkeredStart === 'undefined') root.polsimer_checkeredStart = 0;\r\nif (typeof root.polsimer_checkeredDone === 'undefined') root.polsimer_checkeredDone = false;\r\nvar isCheckeredRaw = $prop('Flag_Checkered') > 0 || $prop('CheckeredFlag') == true;\r\nvar isCheckeredActive = false;\r\n\r\nif (isCheckeredRaw) {\r\n    if (!root.polsimer_checkeredDone) {\r\n        if (root.polsimer_checkeredStart === 0) {\r\n            root.polsimer_checkeredStart = now;\r\n        }\r\n        if (now - root.polsimer_checkeredStart < 10000) {\r\n            isCheckeredActive = true;\r\n        } else {\r\n            root.polsimer_checkeredDone = true;\r\n        }\r\n    }\r\n} else {\r\n    if (root.polsimer_checkeredStart > 0 && !root.polsimer_checkeredDone) {\r\n        if (now - root.polsimer_checkeredStart < 10000) {\r\n            isCheckeredActive = true;\r\n        } else {\r\n            root.polsimer_checkeredDone = true;\r\n        }\r\n    }\r\n}\r\n\r\nif (typeof root.polsimer_greenStart === 'undefined') root.polsimer_greenStart = 0;\r\nif (typeof root.polsimer_wasGreen === 'undefined') root.polsimer_wasGreen = false;\r\nvar isGreenRaw = $prop('Flag_Green') > 0 || $prop('GreenFlag') == true;\r\nif (isGreenRaw) {\r\n    if (!root.polsimer_wasGreen) {\r\n        root.polsimer_greenStart = now;\r\n        root.polsimer_wasGreen = true;\r\n    }\r\n} else {\r\n    if (now - root.polsimer_greenStart >= 5000) {\r\n        root.polsimer_wasGreen = false;\r\n        root.polsimer_greenStart = 0;\r\n    }\r\n}\r\nvar isGreenActive = (root.polsimer_greenStart > 0 && (now - root.polsimer_greenStart < 5000));\r\n\r\nvar isRed = $prop('Flag_Red') > 0 || $prop('RedFlag') == true;\r\nvar isBlack = $prop('Flag_Black') > 0 || $prop('BlackFlag') == true;\r\nvar isSC = $prop('VirtualSafetyCar') || $prop('SafetyCar') || ($prop('Flag_SafetyCar') > 0);\r\nvar isDebris = ($prop('Flag_YellowRed') > 0) || ($prop('Flag_Slippery') > 0) || $prop('SlipperyFlag') == true;\r\nvar isYellow = $prop('Flag_Yellow') > 0 || $prop('YellowFlag') == true;\r\nvar isBlue = $prop('Flag_Blue') > 0 || $prop('BlueFlag') == true;\r\nvar isWhite = $prop('Flag_White') > 0 || $prop('WhiteFlag') == true || $prop('Flag_WhiteFinalLap') > 0;\r\n\r\nvar activeFlag = '';\r\nif (isRed) activeFlag = 'RED';\r\nelse if (isBlack) activeFlag = 'BLACK';\r\nelse if (isCheckeredActive) activeFlag = 'CHECKERED';\r\nelse if (isSC) activeFlag = 'SC';\r\nelse if (isDebris) activeFlag = 'DEBRIS';\r\nelse if (isYellow) activeFlag = 'YELLOW';\r\nelse if (isBlue) activeFlag = 'BLUE';\r\nelse if (isWhite) activeFlag = 'WHITE';\r\nelse if (isGreenActive) activeFlag = 'GREEN';\r\n\r\nif (activeFlag === '') {\r\n    root.polsimer_lastFlagType = '';\r\n    root.polsimer_flagStart = 0;\r\n    return new Array(12).fill('#00000000');\r\n}\r\n\r\nif (root.polsimer_lastFlagType !== activeFlag) {\r\n    root.polsimer_flagStart = now;\r\n    root.polsimer_lastFlagType = activeFlag;\r\n}\r\n\r\nvar elapsed = now - root.polsimer_flagStart;\r\nvar blink360 = (Math.floor(elapsed / 360) % 2) === 0;\r\n\r\nif (activeFlag === 'RED') {\r\n    return new Array(12).fill(blink360 ? '#ffff0000' : '#ff000000');\r\n}\r\n\r\nif (activeFlag === 'BLACK') {\r\n    var out = new Array(12).fill('#ff000000');\r\n    if (blink360) {\r\n        out[0] = '#ffffffff'; out[1] = '#ffffffff';\r\n        out[10] = '#ffffffff'; out[11] = '#ffffffff';\r\n    }\r\n    return out;\r\n}\r\n\r\nif (activeFlag === 'CHECKERED') {\r\n    var step = Math.floor(elapsed / 360) % 2;\r\n    var out = [];\r\n    for (var i = 0; i < 12; i++) {\r\n        var on = (i % 2 === step);\r\n        out.push(on ? '#ffffffff' : '#ff000000');\r\n    }\r\n    return out;\r\n}\r\n\r\nif (activeFlag === 'SC') {\r\n    var out = [];\r\n    for (var i = 0; i < 12; i++) {\r\n        var on = (i % 2 === 0) ? blink360 : !blink360;\r\n        out.push(on ? '#ffffff00' : '#ff000000');\r\n    }\r\n    return out;\r\n}\r\n\r\nif (activeFlag === 'DEBRIS') {\r\n    var out = [];\r\n    var step = Math.floor(elapsed / 360) % 2;\r\n    for (var i = 0; i < 12; i++) {\r\n        var col = ((i + step) % 2 === 0) ? '#ffffff00' : '#ffff0000';\r\n        out.push(col);\r\n    }\r\n    return out;\r\n}\r\n\r\nif (activeFlag === 'YELLOW') {\r\n    return new Array(12).fill(blink360 ? '#ffffff00' : '#ff000000');\r\n}\r\n\r\nif (activeFlag === 'BLUE') {\r\n    return new Array(12).fill(blink360 ? '#ff0022cc' : '#ff000000');\r\n}\r\n\r\nif (activeFlag === 'WHITE') {\r\n    return new Array(12).fill(blink360 ? '#ffffffff' : '#ff000000');\r\n}\r\n\r\nif (activeFlag === 'GREEN') {\r\n    return new Array(12).fill(blink360 ? '#ff00ff00' : '#ff000000');\r\n}\r\n\r\nreturn new Array(12).fill('#00000000');"
          },
