          "Description": "Shift Alert"
        },
        {
          "ContentFormula": {
            "JSExt": 0,
            "Interpreter": 1,
            "Expression": "if ($prop('DataCorePlugin.GameRunning') == 0) return new Array(12).fill('#00000000');\r\nvar inPit = $prop('PitLimiterOn') > 0 || $prop('IsInPitLane') > 0;\r\nif (inPit) return new Array(12).fill('#00000000');\r\nvar isDamaged = false;\r\nif (($prop('Flag_Orange') || 0) > 0 || ($prop('Flag_BlackOrange') || 0) > 0 || $prop('OrangeFlag') == true || $prop('BlackOrangeFlag') == true || $prop('Flag_Meatball') == true || ($prop('EngineBlown') || 0) > 0) {\r\n    isDamaged = true;\r\n}\r\nvar irFlags = $prop('GameRawData.Telemetry.SessionFlags') || 0;\r\nif ((irFlags & 0x00100000) !== 0) isDamaged = true;\r\nif (($prop('GameRawData.Telemetry.PitSvRepairReq') || 0) > 0) isDamaged = true;\r\nif (($prop('GameRawData.Telemetry.PitSvOptionalRepairReq') || 0) > 0) isDamaged = true;\r\nif (($prop('GameRawData.Telemetry.PlayerCarTowTime') || 0) > 0) isDamaged = true;\r\nvar acDmg = $prop('GameRawData.Physics.CarDamage');\r\nif (acDmg && Array.isArray(acDmg)) {\r\n    for (var i = 0; i < acDmg.length; i++) if (acDmg[i] > 1) isDamaged = true;\r\n}\r\nif (($prop('GameRawData.Graphics.GlobalCarDamage') || 0) > 0) isDamaged = true;\r\nif (($prop('GameRawData.Graphics.m_flag') || 0) == 4) isDamaged = true;\r\nvar dmg = $prop('CarDamage') || $prop('NewData.CarDamage') || $prop('Damage') || 0;\r\nif (dmg > 0.05) isDamaged = true;\r\nvar dF = $prop('CarDamage_Front') || 0;\r\nvar dR = $prop('CarDamage_Rear') || 0;\r\nvar dL = $prop('CarDamage_Left') || 0;\r\nvar dRi = $prop('CarDamage_Right') || 0;\r\nif (dF > 0.05 || dR > 0.05 || dL > 0.05 || dRi > 0.05) isDamaged = true;\r\nif (($prop('GameRawData.PlayerCarDamageData.m_frontLeftWingDamage') || 0) > 0 || ($prop('GameRawData.PlayerCarDamageData.m_frontRightWingDamage') || 0) > 0 || ($prop('GameRawData.PlayerCarDamageData.m_rearWingDamage') || 0) > 0 || ($prop('GameRawData.PlayerCarDamageData.m_engineBlown') || 0) > 0) {\r\n    isDamaged = true;\r\n}\r\nif (($prop('GameRawData.mCrashState') || 0) > 0 || ($prop('GameRawData.mCarDamage') || 0) > 0) isDamaged = true;\r\nif (($prop('GameRawData.electrics.damage') || 0) > 0 || ($prop('GameRawData.damage.total') || 0) > 0) isDamaged = true;\r\nif (!isDamaged) return new Array(12).fill('#00000000');\r\nvar now = Date.now();\r\nvar on = (Math.floor(now / 360) % 2) === 0;\r\nreturn new Array(12).fill(on ? '#ffff8c00' : '#ff000000');"
          },
